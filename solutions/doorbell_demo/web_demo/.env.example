# Web demo server (Express) + UI (Vite)
PORT=5174

# LiveKit (required for live view + recording)
LIVEKIT_URL=https://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM=birdfeeder
LIVEKIT_INGRESS_NAME=birdfeeder-device
LIVEKIT_INGRESS_IDENTITY=device

# AWS (required for photo capture + S3 listing/playback + recording uploads)
AWS_REGION=
S3_BUCKET=
S3_PHOTOS_PREFIX=photos/
S3_VIDEOS_PREFIX=recordings/

# AWS IoT Core data endpoint (required for sending MQTT commands from web -> device)
AWS_IOT_DATA_ENDPOINT=
AWS_IOT_TOPIC_CMD=birdfeeder/cmd

# Credentials used by:
# - this server (AWS SDK) for S3 presign + S3 list + IoT publish
# - LiveKit egress S3 upload configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
